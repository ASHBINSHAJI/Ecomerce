
<main class="nextphase-home">
    <section class="np-hero">

        <div class="container">

            <div class="row align-items-center g-5">

                <!-- LEFT -->
                <div class="col-lg-6">

                    <div class="np-hero-content">

                        <span class="np-label">
                            NEXT GENERATION COMPONENTS
                        </span>

                        <h1 class="np-title">
                            Build what's
                            <span>next.</span>
                        </h1>

                        <p class="np-description">
                            Electronics components for students,
                            engineers, makers and creators who
                            turn ideas into reality.
                        </p>

                        <div class="np-actions">

                            <a href="/shop" class="np-btn np-btn-primary">
                                Explore products
                                <i class="bi bi-arrow-up-right"></i>
                            </a>

                            <a href="#seller" class="np-btn np-btn-outline">
                                Become a seller
                            </a>

                        </div>

                    </div>

                </div>


                <!-- RIGHT : LOGIN -->
                <div class="col-lg-5 offset-lg-1">

                    <div class="np-auth-card">

                        <div class="np-auth-heading">

                            <span>WELCOME TO NEXTPHASE</span>

                            <h2>
                                Start building.
                            </h2>

                            <p>
                                <a href="/signup">create new account?</a>
                            </p>

                        </div>


                        <!-- SOCIAL LOGIN -->

                        <div class="row g-2">

                            <div class="col-6">

                                <button
                                    type="button"
                                    class="np-social-btn"
                                >
                                    <i class="bi bi-google"></i>
                                    Google
                                </button>

                            </div>

                            <div class="col-6">

                                <button
                                    type="button"
                                    class="np-social-btn"
                                >
                                    <i class="bi bi-linkedin"></i>
                                    LinkedIn
                                </button>

                            </div>

                        </div>


                        <div class="np-or">
                            <span>OR</span>
                        </div>


                        <!-- AUTH TABS -->

                        <div class="np-auth-tabs">

                            <button
                                type="button"
                                class="np-auth-tab active"
                                data-auth="email"
                            >
                                Email
                            </button>

                            <button
                                type="button"
                                class="np-auth-tab"
                                data-auth="otp"
                            >
                                Mobile OTP
                            </button>

                        </div>


                        <!-- ============================
                             EMAIL FORM
                        ============================= -->
{{#if loginErr}}
<p class="text-danger"><em>{{loginErr}}</em></p>
{{/if}}
                        <form
                        action="/home"
                        method="POST"
                            id="npEmailForm"
                            class="np-auth-form"
                        >

                            <div class="np-input-group">

                                <label for="npEmail">
                                    Email
                                </label>

                                <input
                                    type="email"
                                    id="npEmail"
                                    name="email"
                                    placeholder="you@example.com"
                                    autocomplete="email"
                                    required
                                >

                            </div>


                            <div class="np-input-group">

                                <div class="np-label-row">

                                    <label for="npPassword">
                                        Password
                                    </label>

                                    <a href="#">
                                        Forgot password?
                                    </a>

                                </div>


                                <div class="np-password">

                                    <input
                                        type="password"
                                        id="npPassword"
                                        name="password"
                                        placeholder="Enter your password"
                                        autocomplete="current-password"
                                        required
                                    >

                                    <button
                                        type="button"
                                        id="npPasswordToggle"
                                        aria-label="Show password"
                                    >
                                        <i class="bi bi-eye"></i>
                                    </button>

                                </div>

                            </div>


                            <button
                                type="submit"
                                class="np-submit"
                            >
                                Continue
                                <i class="bi bi-arrow-right"></i>
                            </button>

                        </form>


                        <!-- ============================
                             OTP FORM
                        ============================= -->

                        <form
                            id="npOtpForm"
                            class="np-auth-form np-hidden"
                        >

                            <div class="np-input-group">

                                <label for="npPhone">
                                    Mobile number
                                </label>

                                <div class="np-phone">

                                    <span>+91</span>

                                    <input
                                        type="tel"
                                        id="npPhone"
                                        name="phone"
                                        placeholder="10 digit mobile number"
                                        maxlength="10"
                                        inputmode="numeric"
                                    >

                                </div>

                            </div>


                            <button
                                type="button"
                                id="npSendOtp"
                                class="np-submit"
                            >
                                Send OTP
                                <i class="bi bi-arrow-right"></i>
                            </button>


                            <div
                                id="npOtpVerification"
                                class="np-otp-verification np-hidden"
                            >

                                <div class="np-input-group">

                                    <label for="npOtp">
                                        Verification code
                                    </label>

                                    <input
                                        type="text"
                                        id="npOtp"
                                        maxlength="6"
                                        inputmode="numeric"
                                        placeholder="Enter 6-digit OTP"
                                    >

                                </div>


                                <button
                                    type="button"
                                    class="np-submit"
                                >
                                    Verify OTP
                                </button>

                            </div>

                        </form>


                        <p class="np-auth-footer">
                            By continuing, you agree to our
                            <a href="#">Terms</a> and
                            <a href="#">Privacy Policy</a>.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =================================================
         JOURNEY
    ================================================== -->

    <section
        class="np-journey"
        id="journey"
    >

        <div class="container">

            <div class="np-section-header">

                <span>
                    THE NEXTPHASE JOURNEY
                </span>

                <h2>
                    From idea to
                    <strong>reality.</strong>
                </h2>

                <p>
                    The components are only the beginning.
                    What you build with them is what matters.
                </p>

            </div>


            <div class="np-journey-line">

                <div class="np-journey-progress"></div>


                <div class="np-journey-item">

                    <div class="np-journey-number">
                        01
                    </div>

                    <div class="np-journey-dot"></div>

                    <h3>Imagine</h3>

                    <p>
                        Start with an idea.
                    </p>

                </div>


                <div class="np-journey-item">

                    <div class="np-journey-number">
                        02
                    </div>

                    <div class="np-journey-dot"></div>

                    <h3>Choose</h3>

                    <p>
                        Find the right components.
                    </p>

                </div>


                <div class="np-journey-item">

                    <div class="np-journey-number">
                        03
                    </div>

                    <div class="np-journey-dot"></div>

                    <h3>Build</h3>

                    <p>
                        Turn parts into a system.
                    </p>

                </div>


                <div class="np-journey-item">

                    <div class="np-journey-number">
                        04
                    </div>

                    <div class="np-journey-dot"></div>

                    <h3>Create</h3>

                    <p>
                        Make something useful.
                    </p>

                </div>


                <div class="np-journey-item">

                    <div class="np-journey-number">
                        05
                    </div>

                    <div class="np-journey-dot"></div>

                    <h3>Nextphase</h3>

                    <p>
                        Go beyond the first idea.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- =================================================
         SELLER
    ================================================== -->

  <section class="np-seller" id="seller">

    <div class="container">

        <div class="np-seller-card">

            <!-- HEADER -->

            <div class="np-seller-header">

                <div>
                    <span class="np-label">
                        SELL WITH NEXTPHASE
                    </span>

                    <h2>
                        Put your products
                        <span>in motion.</span>
                    </h2>

                    <p>
                        Join a growing marketplace built for
                        electronics, robotics and makers.
                    </p>
                </div>

                <div class="np-seller-badge">
                    <i class="bi bi-arrow-up-right"></i>
                </div>

            </div>


            <!-- FORM -->

            <form class="np-seller-form" id="sellerForm">

                <div class="np-form-grid">

                    <!-- NAME -->

                    <div class="np-field">

                        <label for="sellerName">
                            Full name
                        </label>

                        <div class="np-field-input">

                            <i class="bi bi-person"></i>

                            <input
                                type="text"
                                id="sellerName"
                                name="name"
                                placeholder="Your full name"
                                autocomplete="name"
                                required
                            >

                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="np-field">

                        <label for="sellerEmail">
                            Email address
                        </label>

                        <div class="np-field-input">

                            <i class="bi bi-envelope"></i>

                            <input
                                type="email"
                                id="sellerEmail"
                                name="email"
                                placeholder="you@example.com"
                                autocomplete="email"
                                required
                            >

                        </div>

                    </div>


                    <!-- STORE -->

                    <div class="np-field">

                        <label for="storeName">
                            Store name
                        </label>

                        <div class="np-field-input">

                            <i class="bi bi-shop"></i>

                            <input
                                type="text"
                                id="storeName"
                                name="storeName"
                                placeholder="Your store name"
                                required
                            >

                        </div>

                    </div>


                    <!-- PHONE -->

                    <div class="np-field">

                        <label for="sellerPhone">
                            Phone number
                        </label>

                        <div class="np-field-input">

                            <i class="bi bi-telephone"></i>

                            <input
                                type="tel"
                                id="sellerPhone"
                                name="phone"
                                placeholder="+91 98765 43210"
                                autocomplete="tel"
                            >

                        </div>

                    </div>


                    <!-- CATEGORY -->

                    <div class="np-field">

                        <label for="sellerCategory">
                            What do you sell?
                        </label>

                        <div class="np-field-input">

                            <i class="bi bi-cpu"></i>

                            <select
                                id="sellerCategory"
                                name="category"
                                required
                            >

                                <option value="" selected disabled>
                                    Select a category
                                </option>

                                <option value="arduino">
                                    Arduino & Boards
                                </option>

                                <option value="raspberry-pi">
                                    Raspberry Pi
                                </option>

                                <option value="esp32">
                                    ESP32
                                </option>

                                <option value="sensors">
                                    Sensors
                                </option>

                                <option value="robotics">
                                    Robotics
                                </option>

                                <option value="components">
                                    Electronic Components
                                </option>

                                <option value="other">
                                    Other
                                </option>

                            </select>

                            <i class="bi bi-chevron-down np-select-arrow"></i>

                        </div>

                    </div>


                    <!-- CITY -->

                    <div class="np-field">

                        <label for="sellerCity">
                            Location
                        </label>

                        <div class="np-field-input">

                            <i class="bi bi-geo-alt"></i>

                            <input
                                type="text"
                                id="sellerCity"
                                name="city"
                                placeholder="City"
                            >

                        </div>

                    </div>


                    <!-- MESSAGE -->

                    <div class="np-field np-field-full">

                        <label for="sellerMessage">
                            Tell us about your products
                        </label>

                        <div class="np-field-textarea">

                            <i class="bi bi-chat-left-text"></i>

                            <textarea
                                id="sellerMessage"
                                name="message"
                                placeholder="What products do you want to sell?"
                                rows="4"
                            ></textarea>

                        </div>

                    </div>

                </div>


                <!-- BOTTOM -->

                <div class="np-form-bottom">

                    <div class="np-form-note">

                        <i class="bi bi-shield-check"></i>

                        <span>
                            Your information stays private.
                        </span>

                    </div>


                    <button
                        type="submit"
                        class="np-seller-submit"
                    >

                        <span>
                            Apply to become a seller
                        </span>

                        <i class="bi bi-arrow-up-right"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

</section>

