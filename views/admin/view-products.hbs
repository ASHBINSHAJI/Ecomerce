<section>
  <div class="container">

    <section class="admin-dashboard py-4">

      <div class="container-fluid">

        <!-- Dashboard Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">

          <div>
            <h2 class="fw-bold mb-1">Admin Dashboard</h2>
            <p class="text-muted mb-0">
              Manage your store and products
            </p>
          </div>

          <button class="btn btn-primary">
            <a
              href="/admin/add-products"
              class="text-decoration-none"
              style="color: rgb(255, 254, 254);"
            >
              <i class="bi bi-plus-lg me-1" style="color: black;"></i>
              Add Product
            </a>
          </button>

        </div>

        <!-- QUICK OVERVIEW -->
        <div class="row g-4 mb-4">

          <!-- Products -->
          <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">
              <div class="card-body">

                <div class="d-flex justify-content-between">

                  <div>
                    <p class="text-muted mb-1">
                      Total Products
                    </p>

                    <h3 class="fw-bold mb-0">
                      {{products.length}}
                    </h3>
                  </div>

                  <i class="bi bi-box-seam fs-2 text-primary"></i>

                </div>

              </div>
            </div>

          </div>

          <!-- Total Sold -->
          <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">
              <div class="card-body">

                <div class="d-flex justify-content-between">

                  <div>
                    <p class="text-muted mb-1">
                      Total Items Sold
                    </p>

                    <h3 class="fw-bold mb-0">
                      {{totalSold}}
                    </h3>
                  </div>

                  <i class="bi bi-cart-check fs-2 text-success"></i>

                </div>

              </div>
            </div>

          </div>

          <!-- Revenue -->
          <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">
              <div class="card-body">

                <div class="d-flex justify-content-between">

                  <div>
                    <p class="text-muted mb-1">
                      Total Revenue
                    </p>

                    <h3 class="fw-bold mb-0">
                      ₹{{totalRevenue}}
                    </h3>
                  </div>

                  <i class="bi bi-currency-rupee fs-2 text-warning"></i>

                </div>

              </div>
            </div>

          </div>

          <!-- Low Stock -->
          <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">
              <div class="card-body">

                <div class="d-flex justify-content-between">

                  <div>
                    <p class="text-muted mb-1">
                      Low Stock
                    </p>

                    <h3 class="fw-bold mb-0">
                      {{lowStock}}
                    </h3>
                  </div>

                  <i class="bi bi-exclamation-triangle fs-2 text-danger"></i>

                </div>

              </div>
            </div>

          </div>

        </div>

        <!-- PRODUCT OVERVIEW -->
        <div class="card border-0 shadow-sm">

          <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center">

              <div>
                <h5 class="fw-bold mb-1">
                  Product Overview
                </h5>

                <small class="text-muted">
                  Sales and inventory overview
                </small>
              </div>

              <button class="btn btn-sm btn-outline-primary">
                View All
              </button>

            </div>

          </div>

          <!-- Responsive Table -->
          <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

              <thead class="table-light">

                <tr>

                  <th>#</th>
                  <th>Product</th>
                  <th>Price</th>
                  <th>Sold</th>
                  <th>Stock</th>
                  <th>Revenue</th>
                  <th>Status</th>

                </tr>

              </thead>

              <tbody>

                {{#each products}}

                  <tr>

                    <!-- Number -->
                    <td>
                      {{@index}}
                    </td>

                    <!-- Product -->
                    <td>

                      <div class="d-flex align-items-center gap-3">

                        <img
                          src="/product-images/{{this._id}}.jpg"
                          width="50"
                          height="50"
                          class="rounded object-fit-cover"
                          alt="{{this.name}}"
                        />

                        <div>

                          <strong>
                            {{this.name}}
                          </strong>

                          <br />

                          <small class="text-muted">
                            {{this.category}}
                          </small>

                        </div>

                      </div>

                    </td>

                    <!-- Price -->
                    <td>
                      {{this.price}}
                    </td>
                    <td>

                    </td>
                    <td>
                      {{this.price}}
                    </td>
                    <!-- Sold -->
                    <td>

                      <strong>
                        {{this.sold}}
                      </strong>

                    </td>

                    <!-- Stock -->
                    <td>
                      {{this.stock}}
                    </td>

                    <!-- Revenue -->
                    <td>
                      {{this.revenue}}
                    </td>

                    <!-- Status -->
                    <td>
                      <a
                        href="/admin/delete-product/{{this._id}}" onclick="return confirm('Are You Want To delete{{this.name}}')"
                        class="btn btn-sm btn-outline-danger"
                      >Delete</a>
                    </td>

                    <td>
                      <a
                        href="/admin/edit-product/{{this._id}}"
                        class="btn btn-sm btn-primary"
                      >EDIT</a>
                    </td>

                    <td>
                      {{#if this.stock}}

                        <span class="badge text-bg-success">
                          In Stock
                        </span>

                      {{else}}

                        <span class="badge text-bg-danger">
                          Out of Stock
                        </span>

                      {{/if}}

                    </td>

                  </tr>

                {{else}}

                  <!-- No products -->
                  <tr>

                    <td colspan="7" class="text-center py-5">

                      <i class="bi bi-box-seam fs-1 text-muted"></i>

                      <p class="text-muted mt-2 mb-0">
                        No products found
                      </p>

                    </td>

                  </tr>

                {{/each}}

              </tbody>

            </table>

          </div>

        </div>

      </div>

    </section>

  </div>
</section>