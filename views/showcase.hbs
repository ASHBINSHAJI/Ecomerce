<style>
  :root {
    --blue: #1264e8;
    --dark: #101828;
    --muted: #667085;
    --border: #e5eaf1;
    --light-blue: #eef5ff;
    --orange: #ff8a3d;
  }

  body {
    background: #ffffff;
    color: var(--dark);
  }

  /* =========================
     SECTION
  ========================= */

  .showcase-section {
    padding: 70px 0 50px;
  }

  .section-title {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -1px;
  }

  .section-line {
    width: 45px;
    height: 4px;
    background: var(--blue);
    border-radius: 10px;
    margin: 12px 0 18px;
  }

  .section-description {
    color: var(--muted);
    line-height: 1.7;
  }

  /* =========================
     CATEGORY FILTER
  ========================= */

  .category-filter {
    border: 1px solid var(--border);
    border-radius: 50px;
    padding: 5px;
    display: flex;
    overflow-x: auto;
    white-space: nowrap;
    background: #fff;
  }

  .category-filter::-webkit-scrollbar {
    display: none;
  }

  .category-btn {
    border: none;
    background: transparent;
    padding: 10px 18px;
    border-radius: 40px;
    color: #475467;
    font-size: 14px;
    font-weight: 500;
    transition: 0.2s;
  }

  .category-btn:hover {
    color: var(--blue);
    background: var(--light-blue);
  }

  .category-btn.active {
    background: var(--blue);
    color: #fff;
  }

  /* =========================
     PRODUCT CARD
  ========================= */

  .product-card {
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    height: 100%;
    transition: 0.25s ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(16, 24, 40, 0.08);
    border-color: #cdddf8;
  }

  .product-img-wrapper {
    height: 180px;
    background: #f7f9fc;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: 0.25s;
  }

  .product-card:hover .product-img {
    transform: scale(1.05);
  }

  .product-body {
    padding: 18px;
  }

  .product-name {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .product-category {
    color: var(--muted);
    font-size: 12px;
  }

  .product-price {
    font-size: 18px;
    font-weight: 700;
    color: var(--dark);
  }

  .cart-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid #cbd8ec;
    background: #fff;
    color: var(--blue);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: 0.2s;
  }

  .cart-btn:hover {
    background: var(--blue);
    color: #fff;
    border-color: var(--blue);
  }

  /* =========================
     OFFER SECTION
  ========================= */

  .offers-section {
    padding: 55px 0 70px;
    background: #f8faff;
  }

  .offer-card {
    min-height: 210px;
    border-radius: 18px;
    padding: 30px;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .offer-blue {
    background: linear-gradient(
      135deg,
      #edf5ff,
      #ffffff
    );
  }

  .offer-orange {
    background: linear-gradient(
      135deg,
      #fff4eb,
      #ffffff
    );
  }

  .offer-title {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -1px;
  }

  .offer-blue .offer-title {
    color: var(--blue);
  }

  .offer-orange .offer-title {
    color: var(--orange);
  }

  .offer-small {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--muted);
  }

  .offer-text {
    color: #475467;
    font-size: 14px;
  }

  .offer-icon {
    position: absolute;
    right: 25px;
    bottom: 20px;
    font-size: 90px;
    opacity: 0.12;
  }

  .offer-btn {
    border-radius: 8px;
    font-weight: 600;
    padding: 9px 18px;
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 768px) {

    .showcase-section {
      padding: 45px 0 35px;
    }

    .section-title {
      font-size: 26px;
    }

    .category-filter {
      border-radius: 12px;
      margin-top: 20px;
    }

    .product-img-wrapper {
      height: 150px;
    }

    .product-body {
      padding: 14px;
    }

    .offer-card {
      min-height: 190px;
      padding: 24px;
    }

    .offer-title {
      font-size: 25px;
    }

    .offer-icon {
      font-size: 70px;
    }
  }
</style>


