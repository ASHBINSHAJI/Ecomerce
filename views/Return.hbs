<!-- Bootstrap -->
<link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
>

<!-- Bootstrap Icons -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
>

<style>
  :root {
    --primary-blue: #1264e8;
    --dark-blue: #0b1f3a;
    --soft-blue: #eef5ff;
    --accent-orange: #ff9f43;
    --border: #e4eaf2;
  }

  body {
    background: #f7f9fc;
    color: var(--dark-blue);
  }

  .return-page {
    max-width: 1150px;
    margin: 40px auto;
  }

  .page-title {
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .page-subtitle {
    color: #718096;
  }

  /* Main card */

  .custom-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: 0 8px 30px rgba(20, 40, 80, 0.05);
  }

  /* Tabs */

  .return-tabs {
    border-bottom: 1px solid var(--border);
  }

  .return-tabs .nav-link {
    border: none;
    color: #718096;
    font-weight: 600;
    padding: 15px 25px;
    border-radius: 0;
  }

  .return-tabs .nav-link.active {
    color: var(--primary-blue);
    border-bottom: 3px solid var(--primary-blue);
    background: transparent;
  }

  /* Product */

  .product-box {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 15px;
    transition: 0.2s;
  }

  .product-box:hover {
    border-color: #b9d2ff;
    background: #fbfdff;
  }

  .product-image {
    width: 75px;
    height: 75px;
    object-fit: contain;
    background: #f5f7fa;
    border-radius: 10px;
  }

  .product-name {
    font-weight: 600;
  }

  .order-id {
    font-size: 13px;
    color: #7b8794;
  }

  /* Reason buttons */

  .reason-option {
    position: relative;
  }

  .reason-option input {
    position: absolute;
    opacity: 0;
  }

  .reason-label {
    display: block;
    padding: 12px 15px;
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
    font-size: 14px;
    transition: 0.2s;
  }

  .reason-option input:checked + .reason-label {
    border-color: var(--primary-blue);
    background: var(--soft-blue);
    color: var(--primary-blue);
    font-weight: 600;
  }

  /* Upload */

  .upload-box {
    border: 2px dashed #ccd7e5;
    border-radius: 14px;
    padding: 30px;
    text-align: center;
    background: #fbfcfe;
    cursor: pointer;
    transition: 0.2s;
  }

  .upload-box:hover {
    border-color: var(--primary-blue);
    background: var(--soft-blue);
  }

  .upload-icon {
    font-size: 28px;
    color: var(--primary-blue);
  }

  /* Buttons */

  .btn-primary-custom {
    background: var(--primary-blue);
    border: none;
    color: white;
    border-radius: 10px;
    padding: 12px 20px;
    font-weight: 600;
  }

  .btn-primary-custom:hover {
    background: #0955cf;
    color: white;
  }

  /* Side cards */

  .side-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 22px;
  }

  .policy-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--soft-blue);
    color: var(--primary-blue);
    border-radius: 10px;
    font-size: 19px;
  }

  .support-card {
    background: linear-gradient(
      135deg,
      #eef5ff,
      #ffffff
    );
  }

  .accent-text {
    color: var(--accent-orange);
  }

  /* Mobile */

  @media (max-width: 768px) {

    .return-page {
      margin: 20px 12px;
    }

    .page-title {
      font-size: 24px;
    }

    .return-tabs .nav-link {
      padding: 13px 10px;
      font-size: 14px;
    }

    .product-image {
      width: 60px;
      height: 60px;
    }

    .product-price {
      display: none;
    }

    .side-card {
      margin-top: 20px;
    }

    .upload-box {
      padding: 25px 15px;
    }
  }
</style>


<div class="container return-page">

  <!-- HEADER -->

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h2 class="page-title mb-1">
        Returns & Report
      </h2>

      <p class="page-subtitle mb-0">
        Return an item or report an issue with your order.
      </p>
    </div>

    <div class="d-none d-md-flex align-items-center gap-2">
      <i class="bi bi-arrow-repeat fs-4 text-primary"></i>

      <div>
        <strong class="d-block">Easy Returns</strong>
        <small class="text-muted">
          Hassle-free process
        </small>
      </div>
    </div>

  </div>


  <div class="row g-4">

    <!-- MAIN -->

    <div class="col-lg-8">

      <div class="custom-card">

        <!-- TABS -->

        <ul
          class="nav nav-tabs return-tabs px-3"
          id="returnTabs"
          role="tablist"
        >

          <li class="nav-item" role="presentation">

            <button
              class="nav-link active"
              data-bs-toggle="tab"
              data-bs-target="#returnItem"
              type="button"
            >
              Return an Item
            </button>

          </li>

          <li class="nav-item" role="presentation">

            <button
              class="nav-link"
              data-bs-toggle="tab"
              data-bs-target="#reportIssue"
              type="button"
            >
              Report an Issue
            </button>

          </li>

        </ul>


        <div class="tab-content p-4">

          <!-- RETURN TAB -->

          <div
            class="tab-pane fade show active"
            id="returnItem"
          >

            <!-- SELECT ORDER -->

            <div class="mb-4">

              <div class="d-flex justify-content-between mb-3">

                <div>
                  <h5 class="fw-bold mb-1">
                    Select Order
                  </h5>

                  <small class="text-muted">
                    Choose the order you want to return
                  </small>
                </div>

                <a href="#" class="text-primary fw-semibold">
                  View All
                </a>

              </div>


              <div class="product-box">

                <div class="d-flex align-items-center">

                  <img
                    src="https://cdn-icons-png.flaticon.com/512/1055/1055666.png"
                    class="product-image me-3"
                  >

                  <div class="flex-grow-1">

                    <div class="product-name">
                      Arduino Uno R3 Board
                    </div>

                    <div class="order-id">
                      Order ID: #KBX78291
                    </div>

                    <div class="order-id">
                      Delivered on: 12 Aug 2026
                    </div>

                  </div>

                  <div class="product-price fw-bold">
                    ₹599
                  </div>

                </div>

              </div>

            </div>


            <!-- RETURN DETAILS -->

            <div class="mb-4">

              <h5 class="fw-bold mb-1">
                Return Details
              </h5>

              <small class="text-muted">
                Tell us why you want to return this item.
              </small>

            </div>


            <!-- REASONS -->

            <div class="row g-2 mb-4">

              <div class="col-md-4 col-6">

                <div class="reason-option">

                  <input
                    type="radio"
                    name="returnReason"
                    id="defective"
                    checked
                  >

                  <label
                    class="reason-label"
                    for="defective"
                  >
                    <i class="bi bi-check-circle me-1"></i>
                    Product Defective
                  </label>

                </div>

              </div>


              <div class="col-md-4 col-6">

                <div class="reason-option">

                  <input
                    type="radio"
                    name="returnReason"
                    id="wrong"
                  >

                  <label
                    class="reason-label"
                    for="wrong"
                  >
                    Wrong Item
                  </label>

                </div>

              </div>


              <div class="col-md-4 col-6">

                <div class="reason-option">

                  <input
                    type="radio"
                    name="returnReason"
                    id="description"
                  >

                  <label
                    class="reason-label"
                    for="description"
                  >
                    Not as Described
                  </label>

                </div>

              </div>


              <div class="col-md-4 col-6">

                <div class="reason-option">

                  <input
                    type="radio"
                    name="returnReason"
                    id="damaged"
                  >

                  <label
                    class="reason-label"
                    for="damaged"
                  >
                    Damaged in Delivery
                  </label>

                </div>

              </div>


              <div class="col-md-4 col-6">

                <div class="reason-option">

                  <input
                    type="radio"
                    name="returnReason"
                    id="mind"
                  >

                  <label
                    class="reason-label"
                    for="mind"
                  >
                    Changed My Mind
                  </label>

                </div>

              </div>


              <div class="col-md-4 col-6">

                <div class="reason-option">

                  <input
                    type="radio"
                    name="returnReason"
                    id="other"
                  >

                  <label
                    class="reason-label"
                    for="other"
                  >
                    Other Reason
                  </label>

                </div>

              </div>

            </div>


            <!-- DESCRIPTION -->

            <div class="mb-4">

              <label class="form-label fw-semibold">
                Describe the issue
              </label>

              <textarea
                class="form-control"
                rows="4"
                placeholder="Please provide more details about the issue..."
              ></textarea>

            </div>


            <!-- UPLOAD -->

            <div class="mb-4">

              <label class="form-label fw-semibold">
                Add Photos
                <span class="text-muted fw-normal">
                  (Optional)
                </span>
              </label>

              <div class="upload-box">

                <i class="bi bi-cloud-arrow-up upload-icon"></i>

                <div class="mt-2">

                  <span class="text-primary fw-semibold">
                    Click to upload
                  </span>

                  <span class="text-muted">
                    or drag & drop
                  </span>

                </div>

                <small class="text-muted">
                  PNG, JPG up to 5MB
                </small>

                <input
                  type="file"
                  class="d-none"
                  accept="image/png,image/jpeg"
                >

              </div>

            </div>


            <!-- SUBMIT -->

            <button
              type="button"
              class="btn btn-primary-custom w-100"
            >

              <i class="bi bi-arrow-return-left me-2"></i>

              Submit Return Request

            </button>

          </div>


          <!-- REPORT TAB -->

          <div
            class="tab-pane fade"
            id="reportIssue"
          >

            <h5 class="fw-bold">
              Report an Issue
            </h5>

            <p class="text-muted">
              Tell us about a problem with your order.
            </p>

            <div class="mb-3">

              <label class="form-label fw-semibold">
                Issue Type
              </label>

              <select class="form-select">

                <option selected>
                  Select an issue
                </option>

                <option>
                  Product damaged
                </option>

                <option>
                  Missing component
                </option>

                <option>
                  Wrong product
                </option>

                <option>
                  Delivery issue
                </option>

                <option>
                  Other
                </option>

              </select>

            </div>


            <div class="mb-4">

              <label class="form-label fw-semibold">
                Describe the problem
              </label>

              <textarea
                class="form-control"
                rows="5"
                placeholder="Explain what happened..."
              ></textarea>

            </div>


            <button
              class="btn btn-primary-custom w-100"
            >

              <i class="bi bi-flag me-2"></i>

              Submit Report

            </button>

          </div>

        </div>

      </div>

    </div>


    <!-- RIGHT SIDE -->

    <div class="col-lg-4">

      <!-- POLICY -->

      <div class="side-card mb-3">

        <div class="d-flex align-items-center mb-3">

          <div class="policy-icon me-3">
            <i class="bi bi-shield-check"></i>
          </div>

          <div>
            <h6 class="fw-bold mb-0">
              Return Policy
            </h6>

            <small class="text-muted">
              Simple & transparent
            </small>
          </div>

        </div>


        <div class="d-flex mb-3">

          <i class="bi bi-clock text-primary me-3"></i>

          <small>
            Returns accepted within
            <strong>7 days</strong> of delivery.
          </small>

        </div>


        <div class="d-flex mb-3">

          <i class="bi bi-box-seam text-primary me-3"></i>

          <small>
            Product should be unused and
            preferably in original packaging.
          </small>

        </div>


        <div class="d-flex">

          <i class="bi bi-cash-stack text-primary me-3"></i>

          <small>
            Refund will normally be processed
            within <strong>5–7 business days</strong>.
          </small>

        </div>

      </div>


      <!-- SUPPORT -->

      <div class="side-card support-card">

        <div class="policy-icon mb-3">

          <i class="bi bi-headset"></i>

        </div>

        <h5 class="fw-bold">
          Need Help?
        </h5>

        <p class="text-muted small">
          Having trouble with your return?
          Our support team can help.
        </p>

        <button class="btn btn-outline-primary w-100">

          <i class="bi bi-chat-dots me-2"></i>

          Contact Support

        </button>

      </div>

    </div>

  </div>

</div>


<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>